# Copie para .env e preencha. O .env nunca é versionado.

# ---------------------------------------------------------------------------
# Fluxo
# ---------------------------------------------------------------------------
FLOW_PATH=flows/example.yml

# ---------------------------------------------------------------------------
# Segurança do webhook  (OBRIGATÓRIO)
# ---------------------------------------------------------------------------
# Sem isto, qualquer pessoa que alcance a porta do bot faz o número conectado
# enviar mensagens arbitrárias. Gere um valor aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Configure o mesmo valor na WAHA, como cabeçalho do webhook
# (X-Webhook-Token) ou como segredo de HMAC.
WEBHOOK_SECRET=

# Só para desenvolvimento local descartável. Em produção, deixe false.
ALLOW_INSECURE_WEBHOOK=false

# ---------------------------------------------------------------------------
# WAHA
# ---------------------------------------------------------------------------
WAHA_URL=http://waha:3000
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Limites
# ---------------------------------------------------------------------------
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=60
MAX_MESSAGE_LENGTH=4096
